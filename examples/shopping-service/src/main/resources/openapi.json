              "exclusiveMinimum": 0
            }
          }
        ]
      }
    },
    "/demo/context": {
      "get": {
        "operationId": "shoppingContext",
        "summary": "Context",
        "x-hoori-permission": "shopping:demo",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestInfo"
                }
              }
            }
          },
          "default": {
            "description": "Public error; raw HTTP parser errors may be plain text.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              },
              "text/plain": {
                "schema": {
