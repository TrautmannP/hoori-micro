  },
  "components": {
    "schemas": {
      "CreateRecipe": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "x-hoori-not-blank": true,
            "x-hoori-max-utf16-length": 200
          }
        },
        "required": [
          "title"
        ]
      },
      "Dashboard": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "recipe": {
            "$ref": "#/components/schemas/RecipeSection"
          },
          "pantry": {
            "$ref": "#/components/schemas/PantrySection"
          }
        },
        "required": [
          "recipe",
          "pantry"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "violations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "code": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "code"
              ]
            },
            "maxItems": 256
          }
        },
        "required": [
          "code"
        ]
      },
      "Overview": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "recipe": {
            "$ref": "#/components/schemas/Recipe"
          },
          "available": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": [
                "string",
                "null"
              ]
            },
            "maxItems": 256
          }
        },
        "required": [
          "recipe",
          "available"
        ]
      },
      "PantrySection": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "status": {
            "type": [
              "string",
              "null"
            ]
          },
          "data": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": [
                "string",
                "null"
              ]
            },
            "maxItems": 256
          }
        },
        "required": [
          "status",
          "data"
        ]
      },
      "Recipe": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "title"
        ]
      },
      "RecipeIds": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64",
              "exclusiveMinimum": 0
            },
            "maxItems": 16,
            "minItems": 1
          }
        },
        "required": [
          "ids"
        ]
      },
      "RecipeSection": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "status": {
            "type": [
              "string",
              "null"
            ]
          },
          "data": {
            "$ref": "#/components/schemas/Recipe"
          }
        },
        "required": [
          "status",
          "data"
        ]
      },
      "RequestInfo": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "requestId": {
            "type": [
              "string",
              "null"
            ]
          },
          "authorization": {
            "type": "boolean"
          }
        },
        "required": [
          "requestId",
          "authorization"
        ]
      }
    }
  }
}
