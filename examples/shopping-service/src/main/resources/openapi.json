                  "$ref": "#/components/schemas/Error"
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "exclusiveMinimum": 0
            }
          }
        ]
      }
    },
    "/dashboard/{id}": {
      "get": {
        "operationId": "shoppingDashboard",
        "summary": "Dashboard",
        "x-hoori-permission": "shopping:read",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
