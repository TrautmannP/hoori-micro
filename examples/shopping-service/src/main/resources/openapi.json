{
  "openapi": "3.1.0",
  "info": {
    "title": "shopping demo API",
    "version": "1.0.0",
    "description": "In-memory development demonstration; no production authentication."
  },
  "x-hoori-service-version": 1,
  "x-hoori-api-group": "public",
  "paths": {
    "/meals/{id}": {
      "get": {
        "operationId": "shoppingGetMeal",
        "summary": "GetMeal",
        "x-hoori-permission": "shopping:read",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Recipe"
                }
              }
            }
          },
          "default": {
            "description": "Public error; raw HTTP parser errors may be plain text.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "exclusiveMinimum": 0
            }
          }
        ]
      },
      "delete": {
        "operationId": "shoppingDeleteMeal",
        "summary": "DeleteMeal",
        "x-hoori-permission": "shopping:write",
        "responses": {
          "204": {
            "description": "Success"
          },
          "default": {
            "description": "Public error; raw HTTP parser errors may be plain text.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "exclusiveMinimum": 0
            }
          }
        ]
      }
    },
    "/meals": {
      "get": {
        "operationId": "shoppingListMeals",
        "summary": "ListMeals",
        "x-hoori-permission": "shopping:read",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "$ref": "#/components/schemas/Recipe"
                  },
                  "maxItems": 256
                }
              }
            }
          },
          "default": {
            "description": "Public error; raw HTTP parser errors may be plain text.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "prefix",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": ""
            }
          }
        ]
      },
      "post": {
        "operationId": "shoppingCreateMeal",
        "summary": "CreateMeal",
        "x-hoori-permission": "shopping:write",
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Recipe"
                }
              }
            },
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                },
                "description": "Created resource path"
              }
            }
          },
          "default": {
            "description": "Public error; raw HTTP parser errors may be plain text.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRecipe"
              }
            }
          }
        }
      }
    },
    "/overview/{id}": {
      "get": {
        "operationId": "shoppingOverview",
        "summary": "Overview",
        "x-hoori-permission": "shopping:read",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
