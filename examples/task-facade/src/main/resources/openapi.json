{
  "openapi": "3.1.0",
  "info": {
    "title": "facade demo API",
    "version": "1.0.0",
    "description": "In-memory development demonstration; no production authentication."
  },
  "x-hoori-service-version": 1,
  "x-hoori-api-group": "public",
  "paths": {
    "/overview/{id}": {
      "get": {
        "operationId": "facadeOverview",
        "summary": "Overview",
        "x-hoori-permission": "facade:read",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Overview"
                }
              }
            }
          },
          "default": {
            "description": "Public error; raw HTTP parser errors may be plain text.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "exclusiveMinimum": 0
            }
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "violations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "code": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "code"
              ]
            },
            "maxItems": 256
          }
        },
        "required": [
          "code"
        ]
      },
      "Overview": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "recipe": {
            "$ref": "#/components/schemas/Recipe"
          },
          "available": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": [
                "string",
                "null"
              ]
            },
            "maxItems": 256
          }
        },
        "required": [
          "recipe",
          "available"
        ]
      },
      "Recipe": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "title"
        ]
      }
    }
  }
}
