<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>dev.hoori</groupId><artifactId>hoori-micro-parent</artifactId><version>0.1.0-SNAPSHOT</version><relativePath>../../pom.xml</relativePath></parent>
  <artifactId>hoori-micro-demo-contracts</artifactId>
  <dependencies>
    <dependency><groupId>dev.hoori</groupId><artifactId>hoori-validation-avaje</artifactId></dependency>
    <dependency><groupId>dev.hoori</groupId><artifactId>hoori-micro</artifactId></dependency>
    <dependency><groupId>dev.hoori</groupId><artifactId>hoori-rest-annotations</artifactId><scope>provided</scope></dependency>
  </dependencies>
  <build><plugins><plugin>
    <groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId>
    <configuration><annotationProcessorPaths>
      <path><groupId>dev.hoori</groupId><artifactId>hoori-rest-processor</artifactId><version>${hoori.sdk.version}</version></path>
      <path><groupId>dev.hoori</groupId><artifactId>hoori-validation-processor</artifactId><version>${hoori.sdk.version}</version></path>
      <path><groupId>io.avaje</groupId><artifactId>avaje-validator-generator</artifactId><version>${avaje.validator.version}</version></path>
    </annotationProcessorPaths><annotationProcessors>
      <annotationProcessor>hoori.validation.processor.ValidationProfileProcessor</annotationProcessor>
      <annotationProcessor>hoori.rest.processor.JsonCodecProcessor</annotationProcessor>
      <annotationProcessor>io.avaje.validation.generator.ValidationProcessor</annotationProcessor>
    </annotationProcessors></configuration>
  </plugin></plugins></build>
</project>
