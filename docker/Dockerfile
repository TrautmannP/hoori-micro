# Build context is generated by scripts/build.sh; no private GitHub credentials enter this image.
# Choose a base compatible with the distribution's architecture/glibc/SYSTEM.txt.
ARG RUNTIME_BASE=debian:trixie-slim@sha256:7792b1f7702a86946cd518db72b6a407302c3e9bc1635634368b878189e8221c
FROM ${RUNTIME_BASE}
# Frozen signed package repositories make a fresh rebuild resolve the same packages.
RUN sed -i \
      -e 's|http://deb.debian.org/debian-security|http://snapshot.debian.org/archive/debian-security/20260930T000000Z/|' \
      -e 's|http://deb.debian.org/debian|http://snapshot.debian.org/archive/debian/20260930T000000Z/|' \
      /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Check-Valid-Until=false update \
    && apt-get install -y --no-install-recommends ca-certificates curl libgcc-s1 zlib1g \
    && rm -rf /var/lib/apt/lists/*
COPY runtime/ /opt/hoori/
COPY dependencies/ /opt/dependencies/
COPY runtime-classpath.txt /opt/runtime-classpath.txt
# Fails at build time on corrupt bundles, missing native dependencies or incompatible ELF.
RUN cd /opt/hoori && ./verify.sh && ./bin/hoori build-info
ARG SERVICE
COPY apps/${SERVICE}/lib/ /opt/app/lib/
COPY docker/entrypoint.sh /usr/local/bin/hoori-service
RUN chmod 0555 /usr/local/bin/hoori-service
WORKDIR /opt/app
USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/hoori-service"]
