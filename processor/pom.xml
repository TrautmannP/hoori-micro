<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>dev.hoori</groupId>
    <artifactId>hoori-micro-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>hoori-micro-processor</artifactId>
  <dependencies>
    <dependency>
      <groupId>jakarta.validation</groupId>
      <artifactId>jakarta.validation-api</artifactId>
      <version>3.1.1</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>dev.hoori</groupId>
      <artifactId>hoori-micro</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.hoori</groupId>
      <artifactId>hoori-rest-mvc-processor</artifactId>
      <version>${hoori.sdk.version}</version>
    </dependency>
    <dependency>
      <groupId>dev.hoori</groupId>
      <artifactId>hoori-task-processor</artifactId>
      <version>${hoori.sdk.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>dev.hoori</groupId>
      <artifactId>hoori-task-annotations</artifactId>
      <version>${hoori.sdk.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>dev.hoori</groupId>
      <artifactId>hoori-transaction-api</artifactId>
      <version>${hoori.sdk.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <proc>none</proc>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
